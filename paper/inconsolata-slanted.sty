%%% inconsolata-slanted.sty -- Enable a fake slanted version of Inconsolata

% From Heiko Oberdiek's answer to Greg Wilson's question "Inconsolata italics?",
% available at <https://tex.stackexchange.com/a/183220/1425>.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{inconsolata-slanted}[2017/07/26 v1.0 Slanted Inconsolata]

\newif\ifslanted@inconsolata
\DeclareOption{inconsolata}{\slanted@inconsolatatrue}
\DeclareOption{zi4}{\slanted@inconsolatafalse}

\ExecuteOptions{inconsolata}
\ProcessOptions\relax

\ifslanted@inconsolata
  \RequirePackage{inconsolata}
\else
  \RequirePackage{zi4}
\fi

\pdfmapfile{+zi4-sl.map}

\sbox0{\ttfamily x}% load .fd file
\expandafter\ifx\csname zifour@scaled\endcsname\relax
  \let\zifour@scaled\@empty
\fi
\expandafter\ifx\csname zifour@opt\endcsname\relax
  \def\zifour@opt{\z@}\def\zifour@altopt{\tw@}
\fi
\DeclareFontShape{\f@encoding}{zi4}{m}{sl}{%
  <-> \zifour@scaled ot1-zi4r-sl-\zifour@opt}{}%
\DeclareFontShape{\f@encoding}{zi4}{m}{it}{%
  <-> ssub * zi4/m/sl}{}
\DeclareFontShape{\f@encoding}{zi4}{b}{sl}{%
  <-> \zifour@scaled ot1-zi4b-sl-\zifour@opt}{}
\DeclareFontShape{\f@encoding}{zi4}{bx}{sl}{%
  <-> ssub * zi4/b/sl}{}
\DeclareFontShape{\f@encoding}{zi4}{b}{it}{%
  <-> ssub * zi4/b/sl}{}
\DeclareFontShape{\f@encoding}{zi4}{bx}{it}{%
  <-> ssub * zi4/b/sl}{}

